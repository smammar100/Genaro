{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "Next.js dev server",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["dev"],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "Storybook",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["storybook", "--no-open"],
      "port": 6006
    },
    {
      "name": "Next.js production server",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["start", "-p", "3100"],
      "port": 3100
    }
  ]
}
